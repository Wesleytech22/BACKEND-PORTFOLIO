# Porta da API.
PORT=3333

# Origens liberadas no CORS, separadas por vírgula. Em desenvolvimento o
# frontend usa o proxy do Vite, então isto só importa em produção.
CORS_ORIGIN=http://localhost:5173

# Token que libera criar, editar e remover projetos e serviços
# (header "Authorization: Bearer <token>"). Sem ele, a API fica só leitura.
# Gere um valor longo e aleatório e nunca o versione.
ADMIN_TOKEN=

# Pasta dos arquivos JSON que guardam os dados.
DATA_DIR=./data
