# Porta da API.
PORT=3333

# Origens liberadas no CORS, separadas por vírgula. Em desenvolvimento o
# frontend usa o proxy do Vite, então isto só importa em produção.
CORS_ORIGIN=http://localhost:5173

# Token que libera criar, editar e remover projetos, serviços e experiências
# (header "Authorization: Bearer <token>"). Sem ele, a API fica só leitura.
# Gere um valor longo e aleatório e nunca o versione.
ADMIN_TOKEN=

# Pasta dos arquivos JSON que guardam os dados.
DATA_DIR=./data

# --- Telegram -------------------------------------------------------------
# 1. Crie um bot com o @BotFather (/newbot) e cole o token aqui.
TELEGRAM_BOT_TOKEN=
# 2. Com TELEGRAM_POLLING=true, suba a API e mande /start para o seu bot:
#    ele responde com o seu chat_id. Cole aqui e reinicie a API.
TELEGRAM_CHAT_ID=
# Polling: o bot recebe comandos sem URL pública (ideal em desenvolvimento).
TELEGRAM_POLLING=true
# Produção com webhook (no lugar do polling): segredo enviado pelo Telegram
# no header X-Telegram-Bot-Api-Secret-Token. Ver README.
TELEGRAM_WEBHOOK_SECRET=
